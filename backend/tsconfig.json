{
  // Node 24 runs the .ts sources directly (type stripping), so tsc is only
  // used for type checking. Only erasable TypeScript syntax is allowed
  // (no enums, namespaces or constructor parameter properties).
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "test", "*.ts"]
}
