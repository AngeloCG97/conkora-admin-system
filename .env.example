# Optional overrides for docker-compose (copy to .env). All have dev defaults.
# The tests read the same variables, so keep them in sync when overriding.
# Production values (Render, Hasura Cloud) are set in each service, never here: docs/despliegue.md.
JWT_SECRET=conkora-dev-jwt-secret-change-me-0123456789
HASURA_ADMIN_SECRET=conkora-dev-admin-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=conkora-dev
JWT_EXPIRES_IN_SECONDS=43200
CORS_ORIGIN=http://localhost:3000
POSTGRES_PORT=5432
HASURA_PORT=8080
API_PORT=4000
